# Database (PostgreSQL via Supabase)
DATABASE_URL=
DIRECT_URL=
# Production migrations only — postgres role with DDL authority (session mode, not pooler)
# MIGRATION_DATABASE_URL=

# Auth
AUTH_SECRET=
AUTH_URL=
NEXT_PUBLIC_APP_URL=

# OpenAI (server-side only — never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_DEMAND_PARSER_MODEL=gpt-4o-mini
OPENAI_INVENTORY_NORMALIZER_MODEL=gpt-4o-mini
OPENAI_MATCH_EXPLAINER_MODEL=gpt-4o-mini

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rematcher.exchange

# Product config overrides (optional JSON)
# PRODUCT_CONFIG_JSON=

# Identity / Monetization (default OFF — see docs/IDENTITY_AND_MONETIZATION_SETUP.md)
# MONETIZATION_ENABLED=false
# TRIAL_ENABLED=false
# NATIVE_PUSH_ENABLED=false
# IDENTITY_PROVIDER_MODE=fake
# BILLING_PROVIDER_MODE=fake
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# APPLE_IAP_SHARED_SECRET=
# GOOGLE_PLAY_WEBHOOK_SECRET=

# Development seed (local/QA only — never set in production)
# SEED_DEMO=true

# Production admin bootstrap (one-time script only)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Run migrations on production build only
# RUN_MIGRATIONS=true

# Email (Resend — transactional signup/approval)
RESEND_API_KEY=
EMAIL_FROM=REMATCHER Exchange <exchange@rematcher.co.il>
EMAIL_REPLY_TO=exchange@rematcher.co.il
REMATCHER_ADMIN_APPROVAL_EMAIL=galsamama@gmail.com

# Production QA scripts (optional override — default: https://exchange.rematcher.co.il)
# E2E_BASE_URL=

# Vehicle media (VPS filesystem)
# MEDIA_ROOT=/var/rematcher-exchange/media
# MEDIA_PUBLIC_BASE_URL=https://exchange.rematcher.co.il/api/media

# Field Test (never Production)
# Copy to .env.field-test locally. See docs/FIELD_TEST_ENVIRONMENT.md
# FIELD_TEST=true
# Use dedicated Postgres + external Field Test MEDIA_ROOT; on the VPS: /srv/gal/rematcher-exchange/field-test/media
