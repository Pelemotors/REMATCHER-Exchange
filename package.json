{
  "name": "dealer-bid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-if-production.js && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:preflight": "tsx scripts/migration-preflight.ts",
    "postinstall": "prisma generate",
    "mobile:sync": "cd mobile && node ../node_modules/@capacitor/cli/bin/capacitor sync android",
    "mobile:open:android": "cd mobile && node ../node_modules/@capacitor/cli/bin/capacitor open android",
    "mobile:open:ios": "cd mobile && node ../node_modules/@capacitor/cli/bin/capacitor open ios",
    "mobile:android:assemble": "cd android && ./gradlew assembleRelease",
    "mobile:acceptance": "tsx scripts/mobile-viewport-acceptance.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^4.82.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "playwright": "^1.63.0",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "optionalDependencies": {
    "@capacitor/ios": "^8.5.2"
  }
}
