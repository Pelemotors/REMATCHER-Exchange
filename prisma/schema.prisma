generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth & Users ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  emailVerifiedAt DateTime?
  role          UserRole  @default(DEALER_USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   DealerMembership[]
  sessions      Session[]
  pushSubs      PushSubscription[]
  notifications Notification[]
  pushCampaigns PushCampaign[]     @relation("PushCampaignCreator")
  pushDeliveries PushDelivery[]
  notificationPreference NotificationPreference?
  buyerInterests BuyerInterest[]
  sellerInterests SellerInterest[]
  aiLogs        AiOperationLog[]
  verificationTokens VerificationToken[]
  privacyConsentDecisions PrivacyConsentDecision[]
  legalAcceptances LegalAcceptance[]
  privacyAiOnboarding PrivacyAiOnboardingState[]
  accountDeletionRequests AccountDeletionRequest[]
}

enum UserRole {
  DEALER_USER
  ADMIN
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dealer {
  id              String           @id @default(cuid())
  businessName    String
  contactName     String
  phone           String
  email           String?
  city            String?
  region          String?
  businessId      String?
  rejectionReason String?
  verificationStatus VerificationStatus @default(PENDING)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberships     DealerMembership[]
  vehicles        Vehicle[]
  demands         Demand[]
  buyerInterests  BuyerInterest[]
  sellerInterests SellerInterest[]
  validationEvents ValidationEvent[]
  revealsAsBuyer  Reveal[]         @relation("BuyerDealer")
  revealsAsSeller Reveal[]         @relation("SellerDealer")
  commercial      DealerCommercial?
  revealUsages    RevealUsage[]
  onboardingState DealerOnboardingState?
  memoryItems     DealerMemoryItem[]
  exchangeEvents  ExchangeEvent[]
  exchangeCases   ExchangeCase[]
  informationRequests InformationRequest[]
  privacyConsentDecisions PrivacyConsentDecision[]
  legalAcceptances LegalAcceptance[]
  privacyAiOnboarding PrivacyAiOnboardingState[]
  accountDeletionRequests AccountDeletionRequest[]
  exchangeLearnings ExchangeLearning[]
}

// ─── Dealer Memory (Agent long-term business context) ───────────

enum DealerMemoryKind {
  PROFILE
  PREFERENCE
  GOAL
  BUSINESS_CONTEXT
  DECISION
  TEMPORARY
}

enum DealerMemoryStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  FORGOTTEN
}

enum DealerMemoryProvenance {
  USER_STATED
  AGENT_INFERRED
  SYSTEM_DERIVED
}

model DealerMemoryItem {
  id            String                 @id @default(cuid())
  dealerId      String
  topicKey      String
  kind          DealerMemoryKind
  status        DealerMemoryStatus     @default(ACTIVE)
  provenance    DealerMemoryProvenance
  summary       String
  details       Json?
  confidence    Float                  @default(1)
  evidenceNote  String?
  expiresAt     DateTime?
  supersedesId  String?
  forgottenAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  dealer        Dealer                 @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  supersedes    DealerMemoryItem?      @relation("MemorySupersede", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  DealerMemoryItem[]     @relation("MemorySupersede")

  @@index([dealerId, status])
  @@index([dealerId, topicKey, status])
  @@index([dealerId, expiresAt])
}

model DealerOnboardingState {
  id                 String    @id @default(cuid())
  dealerId           String    @unique
  introCompletedAt   DateTime?
  profileCompletedAt DateTime?
  inventorySeenAt    DateTime?
  demandSeenAt       DateTime?
  pushPromptedAt     DateTime?
  completedAt        DateTime?
  dismissedAt        DateTime?
  currentStep        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  dealer             Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  DISABLED
}

model DealerMembership {
  id        String   @id @default(cuid())
  userId    String
  dealerId  String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([userId, dealerId])
}

enum MembershipRole {
  OWNER
  MEMBER
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─── Inventory ──────────────────────────────────────────────────

model Vehicle {
  id              String        @id @default(cuid())
  dealerId        String
  status          VehicleStatus @default(ACTIVE)

  // Raw & normalized data
  rawInput        String?
  make            String?
  model           String?
  trim            String?
  year            Int?
  mileage         Int?
  color           String?
  ownershipHand   Int?
  ownershipType   String?
  region          String?
  retailPrice     Int?
  b2bPrice        Int?
  b2bPriceConfirmedAt DateTime?
  conditionNotes  String?

  // Provenance & unknown tracking
  fieldProvenance Json?

  // Freshness (P-03 thresholds configurable)
  lastInventoryUpdate DateTime @default(now())
  lastAvailabilityConfirmedAt DateTime?
  freshnessState  FreshnessState @default(UNKNOWN)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  dealer          Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  candidateMatches CandidateMatch[]
  validationEvents ValidationEvent[]
  sellerOpportunities SellerOpportunity[]
  exchangeEvents  ExchangeEvent[]
  exchangeCases   ExchangeCase[]
  informationRequests InformationRequest[]
}

enum VehicleStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum FreshnessState {
  FRESH
  STALE
  UNKNOWN
  VALIDATION_REQUIRED
}

model InventoryImport {
  id          String   @id @default(cuid())
  dealerId    String
  sourceType  String
  rawContent  String?
  fileName    String?
  status      ImportStatus @default(PENDING)
  previewJson Json?
  resultJson  Json?
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

enum ImportStatus {
  PENDING
  PREVIEW
  CONFIRMED
  FAILED
  COMPLETED
}

// ─── Demand ─────────────────────────────────────────────────────

model Demand {
  id              String       @id @default(cuid())
  dealerId        String
  status          DemandStatus @default(DRAFT)

  rawText         String
  parsedJson      Json?
  confirmedJson   Json?
  parsedAt        DateTime?
  confirmedAt     DateTime?

  expiresAt       DateTime?
  renewedAt       DateTime?

  /** Active Search Intent version id (Matching & Learning 2.0) */
  activeSearchIntentVersionId String? @unique

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  dealer          Dealer       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  constraints     DemandConstraint[]
  candidateMatches CandidateMatch[]
  buyerInterests  BuyerInterest[]
  searchIntentVersions SearchIntentVersion[]
  activeSearchIntentVersion SearchIntentVersion? @relation("DemandActiveIntent", fields: [activeSearchIntentVersionId], references: [id], onDelete: SetNull)
  informationRequests InformationRequest[]
}

enum DemandStatus {
  DRAFT
  PENDING_CONFIRMATION
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SearchIntentStatus {
  DRAFT
  PENDING_CONFIRMATION
  ACTIVE
  SUPERSEDED
  CLOSED
}

model SearchIntentVersion {
  id                    String             @id @default(cuid())
  demandId              String
  version               Int
  status                SearchIntentStatus @default(DRAFT)
  source                String             @default("agent")
  naturalLanguageSummary String?
  structuredIntent      Json
  confirmedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  demand                Demand             @relation(fields: [demandId], references: [id], onDelete: Cascade)
  activeForDemand       Demand?            @relation("DemandActiveIntent")
  candidateMatches      CandidateMatch[]
  exchangeCases         ExchangeCase[]
  informationRequests   InformationRequest[]

  @@unique([demandId, version])
  @@index([demandId, status])
}

model DemandConstraint {
  id          String         @id @default(cuid())
  demandId    String
  field       String
  constraintType ConstraintType
  value       Json
  source      String         @default("user_confirmed")
  createdAt   DateTime       @default(now())

  demand      Demand         @relation(fields: [demandId], references: [id], onDelete: Cascade)
}

enum ConstraintType {
  HARD
  SOFT
  EXCLUSION
  UNKNOWN
}

// ─── Matching ───────────────────────────────────────────────────

model CandidateMatch {
  id              String            @id @default(cuid())
  demandId        String
  vehicleId       String
  status          CandidateMatchStatus @default(CANDIDATE)

  score           Float?
  scoreBand       ScoreBand?
  hardPassed      Boolean           @default(false)
  evaluationJson  Json?
  explanationJson Json?
  explanationText String?

  searchIntentVersionId String?
  engineVersion     String?
  matchBandV2       String?
  evaluationV2Json  Json?
  intelligenceShadowJson Json?
  /** Mass 2.5 — quality vs information completeness */
  resolutionState   CandidateResolutionState @default(RESOLVED)
  decisionBlockingUnknowns Json?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  demand          Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  searchIntentVersion SearchIntentVersion? @relation(fields: [searchIntentVersionId], references: [id], onDelete: SetNull)
  validationEvents ValidationEvent[]
  buyerInterests  BuyerInterest[]
  sellerOpportunities SellerOpportunity[]
  exchangeCases   ExchangeCase[]
  decisionComparisons MatchDecisionComparison[]
  informationRequests InformationRequest[]

  @@unique([demandId, vehicleId])
  @@index([searchIntentVersionId])
  @@index([resolutionState, status])
}

enum CandidateResolutionState {
  RESOLVED
  NEEDS_INFORMATION
}

enum CandidateMatchStatus {
  CANDIDATE
  PENDING_VALIDATION
  VALIDATED
  REJECTED
  HIDDEN
}

enum ScoreBand {
  STRONG
  GOOD
  ALTERNATIVE
  NO_MATCH
  HIDDEN
}

// ─── Validation (≠ Interest) ────────────────────────────────────

model ValidationEvent {
  id              String          @id @default(cuid())
  type            ValidationType
  vehicleId       String
  dealerId        String
  candidateMatchId String?
  status          ValidationStatus @default(PENDING)
  response        String?
  metadataJson    Json?
  requestedAt     DateTime        @default(now())
  respondedAt     DateTime?

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealer          Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  candidateMatch  CandidateMatch? @relation(fields: [candidateMatchId], references: [id], onDelete: SetNull)
}

enum ValidationType {
  AVAILABILITY
  B2B_PRICE
}

enum ValidationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

// ─── Interest & Opportunity ─────────────────────────────────────

model BuyerInterest {
  id              String          @id @default(cuid())
  demandId        String
  dealerId        String
  candidateMatchId String
  userId          String
  status          InterestStatus  @default(INTERESTED)
  rejectReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  demand          Demand          @relation(fields: [demandId], references: [id], onDelete: Cascade)
  dealer          Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  candidateMatch  CandidateMatch  @relation(fields: [candidateMatchId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerOpportunity SellerOpportunity?

  @@unique([candidateMatchId, dealerId])
}

enum InterestStatus {
  INTERESTED
  REJECTED
  NO_RESPONSE
}

model SellerOpportunity {
  id              String          @id @default(cuid())
  candidateMatchId String         @unique
  buyerInterestId String          @unique
  vehicleId       String
  status          OpportunityStatus @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidateMatch  CandidateMatch  @relation(fields: [candidateMatchId], references: [id], onDelete: Cascade)
  buyerInterest   BuyerInterest   @relation(fields: [buyerInterestId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sellerInterest  SellerInterest?
}

enum OpportunityStatus {
  OPEN
  INTERESTED
  REJECTED
  NO_RESPONSE
  CLOSED
}

model SellerInterest {
  id              String          @id @default(cuid())
  opportunityId   String          @unique
  dealerId        String
  userId          String
  status          InterestStatus  @default(INTERESTED)
  rejectReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  opportunity     SellerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  dealer          Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutualInterest  MutualInterest?
}

model MutualInterest {
  id              String          @id @default(cuid())
  sellerInterestId String         @unique
  createdAt       DateTime        @default(now())

  sellerInterest  SellerInterest  @relation(fields: [sellerInterestId], references: [id], onDelete: Cascade)
  reveal          Reveal?
}

model Reveal {
  id              String          @id @default(cuid())
  mutualInterestId String         @unique
  buyerDealerId   String
  sellerDealerId  String
  candidateMatchId String?
  revealedAt      DateTime        @default(now())
  buyerContactJson Json
  sellerContactJson Json
  matchSummaryJson Json?

  mutualInterest  MutualInterest  @relation(fields: [mutualInterestId], references: [id], onDelete: Cascade)
  buyerDealer     Dealer          @relation("BuyerDealer", fields: [buyerDealerId], references: [id])
  sellerDealer    Dealer          @relation("SellerDealer", fields: [sellerDealerId], references: [id])
  outcome         Outcome?
  usages          RevealUsage[]
}

model RevealUsage {
  id        String          @id @default(cuid())
  revealId  String
  dealerId  String
  source    RevealUsageSource
  createdAt DateTime        @default(now())

  reveal    Reveal          @relation(fields: [revealId], references: [id], onDelete: Cascade)
  dealer    Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([revealId, dealerId])
  @@index([dealerId, createdAt])
}

enum RevealUsageSource {
  FREE_LIFETIME
  MONTHLY_PLAN
  GRACE
}

model DealerCommercial {
  id                    String    @id @default(cuid())
  dealerId              String    @unique
  planSlug              String    @default("onboarding")
  planStatus            PlanStatus @default(ACTIVE)
  freeRevealAllowance   Int       @default(5)
  freeRevealUsed        Int       @default(0)
  monthlyRevealAllowance Int      @default(0)
  monthlyRevealUsed     Int       @default(0)
  billingPeriodStart    DateTime  @default(now())
  billingPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  dealer                Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
}

enum PlanStatus {
  ACTIVE
  EXHAUSTED
  ACTION_REQUIRED
  SUSPENDED
}

model Outcome {
  id          String        @id @default(cuid())
  revealId    String        @unique
  status      OutcomeStatus
  notes       String?
  reportedAt  DateTime      @default(now())
  reportedByDealerId String?

  // Learning linkage
  candidateMatchId String?
  demandId         String?
  vehicleId        String?
  buyerDealerId    String?
  sellerDealerId   String?
  matchScore       Float?
  scoreBand        String?
  priceGapPercent  Float?
  freshnessState   String?
  learningJson     Json?

  reveal      Reveal        @relation(fields: [revealId], references: [id], onDelete: Cascade)
}

enum OutcomeStatus {
  DEAL_CLOSED
  PRICE_DIDNT_WORK
  VEHICLE_DIDNT_FIT
  DID_NOT_PROGRESS
  STILL_IN_PROGRESS
}

// ─── Notifications ──────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  link        String?
  entityType  String?
  entityId    String?
  sourceCategory NotificationSourceCategory @default(PRODUCT)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDeliveries PushDelivery[]

  @@index([userId, readAt])
  @@index([userId, sourceCategory, createdAt])
}

enum NotificationSourceCategory {
  PRODUCT
  REMINDER
  ADMIN
  SYSTEM
}

enum NotificationType {
  VALIDATION_REQUEST
  BUYER_MATCH
  SELLER_OPPORTUNITY
  MUTUAL_INTEREST
  REVEAL
  DEMAND_EXPIRY
  FRESHNESS
  DEALER_VERIFICATION
  OUTCOME_REMINDER
  INVENTORY_ENRICHMENT
  SYSTEM
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  invalidatedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
}

model NotificationPreference {
  userId              String   @id
  criticalProduct     Boolean  @default(true)
  reminders           Boolean  @default(true)
  adminCommunications Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PushSource {
  PRODUCT
  ADMIN_CAMPAIGN
  ADMIN_DIRECT
  ADMIN_TEST
  SMART_REMINDER
  SYSTEM
}

enum PushTriggerType {
  MATCH_CREATED
  MATCH_NOTIFIED
  MUTUAL_INTEREST
  REVEAL_CREATED
  DEMAND_EXPIRING
  OUTCOME_PENDING
  VALIDATION_REQUEST
  FRESHNESS
  ADMIN_MANUAL
  SYSTEM
}

enum PushDeliveryStatus {
  CREATED
  SEND_ATTEMPTED
  SENT
  DELIVERY_FAILED
  RECEIVED
  CLICKED
  DESTINATION_OPENED
}

enum PushAudienceType {
  ALL
  SINGLE
  MULTIPLE
  FILTER
}

model PushCampaign {
  id                     String           @id @default(cuid())
  internalName           String?
  title                  String
  body                   String
  destinationLink        String?
  source                 PushSource
  audienceType           PushAudienceType
  audienceDefinitionJson Json?
  createdByUserId        String
  createdAt              DateTime         @default(now())
  sentAt                 DateTime?
  selectedCount          Int              @default(0)
  eligibleCount          Int              @default(0)
  sendAttemptedCount     Int              @default(0)
  sentCount              Int              @default(0)
  failedCount            Int              @default(0)
  receivedCount          Int              @default(0)
  clickedCount           Int              @default(0)
  destinationOpenedCount Int              @default(0)

  createdBy User @relation("PushCampaignCreator", fields: [createdByUserId], references: [id])
  deliveries PushDelivery[]

  @@index([createdByUserId, createdAt])
  @@index([source, createdAt])
}

model PushDelivery {
  id                 String             @id @default(cuid())
  campaignId         String?
  notificationId     String?
  userId             String
  pushSubscriptionId String?
  dealerId           String?
  source             PushSource
  triggerType        PushTriggerType?
  status             PushDeliveryStatus @default(CREATED)
  title              String
  body               String
  link               String?
  idempotencyKey     String?            @unique
  failureCategory    String?
  createdAt          DateTime           @default(now())
  sendAttemptedAt    DateTime?
  sentAt             DateTime?
  failedAt           DateTime?
  receivedAt         DateTime?
  clickedAt          DateTime?
  destinationOpenedAt DateTime?
  metadataJson       Json?

  campaign         PushCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)
  notification     Notification?     @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([notificationId])
  @@index([dealerId, createdAt])
}

// ─── Product Config & AI Logs ───────────────────────────────────

model ProductConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AiOperationLog {
  id            String   @id @default(cuid())
  operation     String
  model         String?
  promptVersion String?
  success       Boolean
  latencyMs     Int?
  usageJson     Json?
  errorMessage  String?
  entityType    String?
  entityId      String?
  userId        String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([operation, createdAt])
}

model AppEvent {
  id          String   @id @default(cuid())
  eventType   String
  eventVersion Int     @default(1)
  entityType  String?
  entityId    String?
  dealerId    String?
  userId      String?
  source      String?
  idempotencyKey String? @unique
  metadataJson Json?
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([dealerId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([source, createdAt])
}

// ─── Exchange Learning 2.0 (Events / Cases / Learnings) ─────────

enum ExchangeEvidenceType {
  SYSTEM_OBSERVED
  DEALER_REPORTED
  BILATERAL_CONFIRMED
  AI_INFERRED
}

enum ExchangePrivacyClass {
  SYSTEM
  DEALER_SCOPED
  AGGREGATE_SAFE
  RESTRICTED
}

model ExchangeEvent {
  id               String               @id @default(cuid())
  eventType        String
  occurredAt       DateTime             @default(now())
  evidenceType     ExchangeEvidenceType @default(SYSTEM_OBSERVED)
  confidence       Float                @default(1)
  evidenceNote     String?
  dealerId         String?
  vehicleId        String?
  demandId         String?
  candidateMatchId String?
  eventData        Json?
  reason           String?
  privacyClass     ExchangePrivacyClass @default(DEALER_SCOPED)
  idempotencyKey   String?              @unique
  createdAt        DateTime             @default(now())

  dealer           Dealer?              @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  vehicle          Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([dealerId, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([demandId, occurredAt])
  @@index([candidateMatchId])
}

enum RelevanceOutcome {
  RELEVANT
  IRRELEVANT
  UNKNOWN
}

enum TransactionOutcome {
  DEAL_CONFIRMED
  NO_DEAL
  STILL_ACTIVE
  UNKNOWN
}

enum OutcomeReasonCategory {
  PRICE
  VEHICLE_CONDITION
  SPEC_MISMATCH
  AVAILABILITY
  CUSTOMER_CHANGED_MIND
  FINANCING
  DEALER_DECISION
  TIMING
  SOLD_ELSEWHERE
  NO_RESPONSE
  OTHER
  UNKNOWN
}

model ExchangeCase {
  id                      String                 @id @default(cuid())
  caseType                String                 @default("MATCH")
  dealerId                String?
  demandId                String?
  vehicleId               String?
  candidateMatchId        String?
  searchIntentVersionId   String?
  demandSnapshot          Json?
  vehicleSnapshot         Json?
  matchEvaluationSnapshot Json?
  searchIntentSnapshot    Json?
  rationale               String?
  relevanceOutcome        RelevanceOutcome       @default(UNKNOWN)
  transactionOutcome      TransactionOutcome     @default(UNKNOWN)
  outcomeReasonCategory   OutcomeReasonCategory  @default(UNKNOWN)
  evidenceType            ExchangeEvidenceType   @default(SYSTEM_OBSERVED)
  /** When false, case remains operational but must not feed Exchange Learning / Intelligence retrieval. */
  learningEligible        Boolean                @default(false)
  closedAt                DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  dealer                  Dealer?                @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  vehicle                 Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  candidateMatch          CandidateMatch?        @relation(fields: [candidateMatchId], references: [id], onDelete: SetNull)
  searchIntentVersion     SearchIntentVersion?   @relation(fields: [searchIntentVersionId], references: [id], onDelete: SetNull)

  @@index([caseType, createdAt])
  @@index([candidateMatchId])
  @@index([vehicleId, createdAt])
  @@index([demandId, createdAt])
  @@index([learningEligible, createdAt])
}

enum ExchangeLearningStatus {
  ACTIVE
  WEAKENED
  SUPERSEDED
  STALE
}

model ExchangeLearning {
  id                   String                 @id @default(cuid())
  topic                String
  learningType         String
  summary              String
  structuredInsight    Json?
  segmentContext       Json?
  supportingCaseIds    Json?
  contradictingCaseIds Json?
  supportCount         Int                    @default(0)
  contradictCount      Int                    @default(0)
  confidence           Float                  @default(0.3)
  /** Optional dealer-scoped learning (identity-aware, never for disclosure) */
  dealerId             String?
  validFrom            DateTime?
  validTo              DateTime?
  status               ExchangeLearningStatus @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  lastEvaluatedAt      DateTime?

  dealer               Dealer?                @relation(fields: [dealerId], references: [id], onDelete: SetNull)

  @@index([topic, status])
  @@index([learningType, status])
  @@index([status, lastEvaluatedAt])
  @@index([dealerId, status])
}

// ─── Privacy & AI Model v1 ──────────────────────────────────────

enum PrivacyConsentType {
  DEALER_MEMORY
  AGENT_TO_EXCHANGE_LEARNING
  EXCHANGE_ACTIVITY_LEARNING
  EXTERNAL_ACTIVITY_LEARNING
}

/** Append-only consent audit trail. Current state = latest row per type. */
model PrivacyConsentDecision {
  id                   String             @id @default(cuid())
  userId               String
  dealerId             String
  consentType          PrivacyConsentType
  value                Boolean
  consentTextVersion   String
  privacyPolicyVersion String
  source               String?
  createdAt            DateTime           @default(now())

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer               Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, consentType, createdAt])
  @@index([userId, consentType, createdAt])
}

model LegalAcceptance {
  id                   String   @id @default(cuid())
  userId               String
  dealerId             String
  termsVersion         String
  privacyPolicyVersion String
  consentTextVersion   String
  source               String?
  acceptedAt           DateTime @default(now())

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer               Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([userId, dealerId, acceptedAt])
  @@index([dealerId, acceptedAt])
}

model PrivacyAiOnboardingState {
  id          String    @id @default(cuid())
  userId      String
  dealerId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer      Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([userId, dealerId])
}

enum AccountDeletionStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

model AccountDeletionRequest {
  id          String                @id @default(cuid())
  userId      String
  dealerId    String
  status      AccountDeletionStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  confirmedAt DateTime?
  completedAt DateTime?
  note        String?

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealer      Dealer                @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, status])
  @@index([userId, status])
}

model MatchDecisionComparison {
  id                     String   @id @default(cuid())
  candidateMatchId       String
  engineBand             String
  engineScore            Float?
  intelligenceDecision   Json
  intelligenceBand       String?
  intelligenceConfidence Float?
  modelVersion           String?
  promptVersion          String?
  createdAt              DateTime @default(now())

  candidateMatch         CandidateMatch @relation(fields: [candidateMatchId], references: [id], onDelete: Cascade)

  @@index([candidateMatchId, createdAt])
  @@index([engineBand, intelligenceBand])
}

// ─── Mass 2.5 — Interest-driven inventory enrichment ────────────

enum InformationRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
  EXPIRED
}

model InformationRequest {
  id                    String                    @id @default(cuid())
  requesterDealerId     String
  vehicleId             String
  demandId              String
  searchIntentVersionId String?
  candidateMatchId      String
  requestedFields       Json
  fieldsHash            String
  status                InformationRequestStatus  @default(OPEN)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  fulfilledAt           DateTime?
  cancelledAt           DateTime?

  requesterDealer       Dealer                    @relation(fields: [requesterDealerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  demand                Demand                    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  searchIntentVersion   SearchIntentVersion?      @relation(fields: [searchIntentVersionId], references: [id], onDelete: SetNull)
  candidateMatch        CandidateMatch            @relation(fields: [candidateMatchId], references: [id], onDelete: Cascade)

  @@unique([requesterDealerId, candidateMatchId, fieldsHash])
  @@index([vehicleId, status])
  @@index([demandId, status])
  @@index([candidateMatchId, status])
  @@index([status, updatedAt])
}

// ─── Rate Limiting (shared across serverless instances) ───────────

model RateLimitEntry {
  bucket    String
  key       String
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@id([bucket, key])
  @@index([resetAt])
}
